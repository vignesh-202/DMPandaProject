# ============================================================
# DM Panda Worker Node - Quick Start Config
# ============================================================
# To run this worker on ANY laptop, cheap VPS, or cloud spot instance,
# you only need these 2 environment variables:

STREAMER_WS_URL=wss://streamer.dmpanda.com/workers
WORKER_SHARED_SECRET=your_long_random_shared_secret

# --- Optional Hardware & Identity Overrides ---
# (If omitted, worker auto-generates instance ID and auto-detects CPU capacity)
# WORKER_INSTANCE_ID=my-vps-node-1
# WORKER_MAX_CONCURRENCY=20

# --- Optional Direct Standalone Mode (Only needed if running without streamer) ---
# APPWRITE_ENDPOINT=https://appwrite.dmpanda.com/v1
# APPWRITE_PROJECT_ID=your_project_id
# APPWRITE_DATABASE_ID=698b09ff002b91aff785
# INSTAGRAM_APP_ID=your_meta_app_id
# INSTAGRAM_APP_SECRET=your_meta_app_secret
# DM_PANDA_REDIRECT_BASE_URL=https://dmpanda.com
