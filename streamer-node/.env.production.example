# ============================================================
# DM Panda Streamer Node - Production Environment Template
# Domain / Service: https://streamer.dmpanda.com
# ============================================================

PORT=3010

# Meta Webhook Verification Token (set same in Meta App Dashboard)
META_VERIFY_TOKEN=your_meta_verify_token

# Shared Secret between Streamer Node and Worker Node(s)
WORKER_SHARED_SECRET=your_production_streamer_worker_secret

# Job queue timeouts & retry configuration
STREAMER_ASSIGN_TIMEOUT_MS=3000
STREAMER_JOB_HEARTBEAT_TIMEOUT_MS=30000
STREAMER_TIMEOUT_SWEEP_MS=2000
STREAMER_MAX_JOB_ATTEMPTS=5
