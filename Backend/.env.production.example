# ============================================================
# DM Panda Backend API - Production Environment Template
# Domain: https://api.dmpanda.com
# ============================================================

PORT=5000

# Appwrite Self-Hosted Production Endpoint
APPWRITE_ENDPOINT=https://appwrite.dmpanda.com/v1
APPWRITE_PROJECT_ID=698b02ba00099a63b1f1
APPWRITE_API_KEY=your_appwrite_api_key_here
APPWRITE_DATABASE_ID=698b09ff002b91aff785
APPWRITE_STORAGE_ID=698b0a36003e26cda5f4

# Allowed CORS Origins
FRONTEND_ORIGIN=https://dmpanda.com
ADMIN_PANEL_ORIGIN=https://admin.dmpanda.com
BACKEND_PUBLIC_ORIGIN=https://api.dmpanda.com

# Meta / Instagram App
INSTAGRAM_APP_ID=504316872356727
INSTAGRAM_APP_SECRET=your_instagram_app_secret_here
INSTAGRAM_APP_VERSION=v24.0
INSTAGRAM_REDIRECT_URL=https://dmpanda.com/auth/ig-callback
INSTAGRAM_AUTH_URL=https://www.instagram.com/oauth/authorize?force_reauth=true&client_id=504316872356727&redirect_uri=https://dmpanda.com/auth/ig-callback&response_type=code&scope=instagram_business_basic,instagram_business_manage_messages,instagram_business_manage_comments,instagram_business_content_publish,instagram_business_manage_insights

# Razorpay (rzp_live for production)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_here

# Streamer Service URL
STREAMER_URL=https://streamer.dmpanda.com

# Appwrite Function Names
FUNCTION_REMOVE_INSTAGRAM=remove-instagram
